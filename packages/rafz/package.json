{
  "name": "@react-spring/rafz",
  "version": "11.0.0-beta.0",
  "description": "react-spring's fork of rafz one frameloop to rule them all",
  "type": "module",
  "module": "./dist/react-spring_rafz.modern.mjs",
  "types": "./dist/react-spring_rafz.modern.d.mts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/react-spring_rafz.modern.d.mts",
      "default": "./dist/react-spring_rafz.modern.mjs"
    }
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pmndrs/react-spring.git"
  },
  "homepage": "https://github.com/pmndrs/react-spring/tree/main/packages/rafz#readme",
  "keywords": [
    "animated",
    "animation",
    "hooks",
    "motion",
    "react",
    "spring",
    "typescript",
    "velocity"
  ],
  "license": "MIT",
  "author": "Josh Ellis",
  "publishConfig": {
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist && tsdown",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist",
    "dev": "tsdown --watch",
    "pack": "pnpm pack && mv *.tgz package.tgz"
  }
}
