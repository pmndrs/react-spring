{
  "include": [
    "packages/core/test/setup.ts",
    "packages/*/src/**/*",
    "targets/*/src/**/*",
    "packages/types/*",
    "**/*.test.ts",
    "**/*.test.tsx",
    "tests/**/*",
    "vitest.config.ts",
    "targets/zdog/@types/**/*"
  ],
  "exclude": [
    "packages/*/src/types/**/*",
    "targets/*/src/types/**/*",
    "docs/**/*"
  ],
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["DOM", "ESNext"],
    "jsx": "react",
    "noEmit": true,
    "downlevelIteration": true,
    "strict": true,
    "noUnusedLocals": true,
    "moduleResolution": "Bundler",
    "baseUrl": "./",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "types": ["vitest/globals", "@vitest/browser/providers/playwright"]
  }
}
